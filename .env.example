# Copy to .env and fill in the blanks. Never commit .env.
# Get the bot token from @BotFather, the API key from platform.deepseek.com,
# and your Telegram ID from @userinfobot.

# --- required ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# --- optional ---
# Must match the host user that owns ./data, or the container cannot write to
# the bind mount. On a normal Ubuntu VPS this is 1000; check with `id -u`.
APP_UID=1000
APP_GID=1000

# DeepSeek's API has thinking mode on by default. Off = faster and ~2x cheaper
# on output tokens, which is the right trade for a chat bot.
DEEPSEEK_THINKING=false

TZ=Asia/Jakarta
DB_PATH=./data/agent.db
FEEDS_PATH=./feeds.json

# How many past messages to replay as context to the model.
HISTORY_MESSAGES=20
# Hard stop on the tool-calling loop so a confused model cannot spin forever.
MAX_TOOL_ITERATIONS=6
MAX_OUTPUT_TOKENS=1200
DEFAULT_DAILY_LIMIT=50

# Seconds. A tool may not outlive TOOL_TIMEOUT_SECONDS; a whole agent turn
# may not outlive REQUEST_TIMEOUT_SECONDS.
TOOL_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=60

# Set to 1 to also include the thinking trace in the reply. Debug only.
SHOW_THINKING=false

LOG_LEVEL=INFO
